<Window x:Class="FileContext.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileContext"
        Height="650"
        Width="1000"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="FileContext"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <DockPanel Grid.Row="1"
                   Margin="0,0,0,16">

            <Button Content="+ Yeni Kayıt"
                    Width="120"
                    Height="36"
                    DockPanel.Dock="Right"
                    Margin="10,0,0,0"
                    Click="NewEntry_Click"/>

            <TextBox x:Name="SearchTextBox"
                     Height="36"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Başlık, bağlam, sonraki işlem, etiket veya path ara..."/>

        </DockPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="EntriesList">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,12"
                                Padding="16">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- BAŞLIK -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                                <!-- PATH -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Path}"
                                           Margin="0,8,0,16"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"/>

                                <!-- ALT BİLGİ ALANI -->
                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- SOL: BAĞLAM -->
                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Bağlam / Açıklama"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <!-- SAĞ: DURUM / SONRAKİ İŞLEM / ETİKET -->
                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="Durum"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding Status}"
                                                   Margin="0,4,0,14"/>

                                        <TextBlock Text="Sonraki İşlem"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding NextAction}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,14"/>

                                        <TextBlock Text="Etiketler"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding Tags}"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,18,0,0">

                                        <Button Content="Aç"
                                                Width="70"
                                                Height="30"
                                                Margin="0,0,8,0"
                                                Tag="{Binding}"
                                                Click="OpenEntry_Click"/>

                                        <Button Content="Düzenle"
                                                Width="80"
                                                Height="30"
                                                Margin="0,0,8,0"
                                                Tag="{Binding}"
                                                Click="EditEntry_Click"/>

                                        <Button Content="Sil"
                                                Width="60"
                                                Height="30"
                                                Tag="{Binding}"
                                                Click="DeleteEntry_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>
</Window>