<Window
    x:Class="FileContext.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FileContext"
    Width="1100"
    Height="700"
    MinWidth="850"
    MinHeight="550"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="28"
            FontWeight="SemiBold"
            Text="FileContext" />


        <!--  ARAMA  -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16">

            <Button
                Width="120"
                Height="36"
                Margin="10,0,0,0"
                Click="NewEntry_Click"
                Content="+ Yeni Kayıt"
                DockPanel.Dock="Right" />

            <TextBox
                x:Name="SearchTextBox"
                Height="36"
                Padding="10,0"
                VerticalContentAlignment="Center"
                FontSize="15"
                TextChanged="SearchTextBox_TextChanged"
                ToolTip="Bağlam veya fiziksel dosya ara..." />

        </DockPanel>

        <!--  STORAGE OVERVIEW  -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">

            <TextBlock
                Margin="0,0,0,10"
                FontSize="17"
                FontWeight="SemiBold"
                Text="Storage Overview" />

            <ItemsControl x:Name="DrivesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Width="245"
                            Margin="0,0,10,10"
                            Padding="12"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="6">

                            <StackPanel>

                                <TextBlock FontSize="17" FontWeight="SemiBold">
                                    <Run Text="{Binding Name}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding VolumeLabel}" />
                                </TextBlock>

                                <TextBlock
                                    Margin="0,3,0,10"
                                    Foreground="Gray"
                                    Text="{Binding DriveType}" />

                                <TextBlock Margin="0,0,0,3" Text="{Binding ReadSpeedText, StringFormat=Read: {0}}" />

                                <TextBlock Margin="0,0,0,10" Text="{Binding WriteSpeedText, StringFormat=Write: {0}}" />

                                <ProgressBar
                                    Height="8"
                                    Margin="0,0,0,10"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding UsedPercentage}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,3"
                                        Text="Kullanılan:" />

                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Text="{Binding UsedSizeText}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,20,8,3"
                                        Text="Boş:" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,20,0,3"
                                        HorizontalAlignment="Right"
                                        Text="{Binding FreeSpaceText}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,40,8,0"
                                        Text="Toplam:" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,40,0,0"
                                        HorizontalAlignment="Right"
                                        Text="{Binding TotalSizeText}" />

                                </Grid>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,6,0,8">

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                    <TextBlock
                        x:Name="LiveStatusText"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        Text="LIVE" />

                    <Button
                        x:Name="LivePauseButton"
                        Width="80"
                        Height="26"
                        Click="ToggleLivePause_Click"
                        Content="Pause" />

                </StackPanel>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Active I/O Processes" />

            </DockPanel>

            <ItemsControl x:Name="ActiveProcessesList">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="0,2,0,2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Style="{StaticResource SelectableText}"
                                Text="{Binding Name}" />

                            <TextBox
                                Grid.Column="1"
                                Style="{StaticResource SelectableText}"
                                Text="{Binding ProcessId, StringFormat=PID {0}}" />

                            <TextBox
                                Grid.Column="2"
                                Style="{StaticResource SelectableText}"
                                Text="{Binding ReadSpeedText, StringFormat=Read: {0}}" />

                            <TextBox
                                Grid.Column="3"
                                Style="{StaticResource SelectableText}"
                                Text="{Binding WriteSpeedText, StringFormat=Write: {0}}" />

                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <TextBlock
                Margin="0,12,0,8"
                FontSize="15"
                FontWeight="SemiBold"
                Text="Recent File I/O" />

            <ListBox
                x:Name="RecentFileIoList"
                MaxHeight="160"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="6,3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" />

                            <TextBlock Grid.Column="1" Text="{Binding ProcessId, StringFormat=PID {0}}" />

                            <TextBlock
                                Grid.Column="2"
                                FontWeight="SemiBold"
                                Text="{Binding Operation}" />

                            <TextBox
                                Grid.Column="3"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsReadOnly="True"
                                Text="{Binding Path}"
                                TextWrapping="NoWrap"
                                ToolTip="{Binding Path}" />

                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <TextBlock
                Margin="0,12,0,8"
                FontSize="15"
                FontWeight="SemiBold"
                Text="Probable Transfers" />

            <ItemsControl x:Name="ProbableTransfersList">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Margin="0,0,0,8"
                            Padding="10"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="5">

                            <StackPanel>

                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding ProcessName}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding ProcessId, StringFormat=PID {0}}" />
                                </TextBlock>

                                <TextBox
                                    Margin="0,5,0,2"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    Text="{Binding SourcePath}"
                                    ToolTip="{Binding SourcePath}" />

                                <TextBlock
                                    Margin="0,2"
                                    FontWeight="SemiBold"
                                    Text="↓" />

                                <TextBox
                                    Margin="0,2,0,4"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    Text="{Binding TargetPath}"
                                    ToolTip="{Binding TargetPath}" />

                                <TextBlock Foreground="Gray" Text="{Binding Confidence, StringFormat=Confidence: {0}}" />

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

        <Grid Grid.Row="3">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  FILECONTEXT KAYITLARI  -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock
                        x:Name="ContextHeader"
                        Margin="0,0,0,10"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="Bağlam Kayıtları" />

                    <ItemsControl x:Name="EntriesList">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Margin="0,0,0,12"
                                    Padding="16"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,8,0,16"
                                            Foreground="Gray"
                                            Text="{Binding Path}"
                                            TextWrapping="Wrap" />

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock
                                                    Margin="0,0,0,6"
                                                    FontWeight="SemiBold"
                                                    Text="Bağlam / Açıklama" />

                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />

                                                <StackPanel Margin="0,18,0,0" Orientation="Horizontal">

                                                    <Button
                                                        Width="70"
                                                        Height="30"
                                                        Margin="0,0,8,0"
                                                        Click="OpenEntry_Click"
                                                        Content="Aç"
                                                        Tag="{Binding}" />

                                                    <Button
                                                        Width="80"
                                                        Height="30"
                                                        Margin="0,0,8,0"
                                                        Click="EditEntry_Click"
                                                        Content="Düzenle"
                                                        Tag="{Binding}" />

                                                    <Button
                                                        Width="60"
                                                        Height="30"
                                                        Click="DeleteEntry_Click"
                                                        Content="Sil"
                                                        Tag="{Binding}" />

                                                </StackPanel>

                                            </StackPanel>

                                            <StackPanel Grid.Column="2">

                                                <TextBlock FontWeight="SemiBold" Text="Durum" />

                                                <TextBlock Margin="0,4,0,14" Text="{Binding Status}" />

                                                <TextBlock FontWeight="SemiBold" Text="Sonraki İşlem" />

                                                <TextBlock
                                                    Margin="0,4,0,14"
                                                    Text="{Binding NextAction}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock FontWeight="SemiBold" Text="Etiketler" />

                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    Foreground="Gray"
                                                    Text="{Binding Tags}"
                                                    TextWrapping="Wrap" />

                                            </StackPanel>

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </ScrollViewer>

            <GridSplitter
                Grid.Row="1"
                Height="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="#D0D0D0"
                Cursor="SizeNS"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Rows" />

            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  EVERYTHING BAŞLIK  -->
                <TextBlock
                    x:Name="EverythingHeader"
                    Grid.Row="0"
                    Margin="0,14,0,10"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="Everything Sonuçları"
                    Visibility="Collapsed" />

                <!--  VIRTUALIZED EVERYTHING RESULTS  -->
                <ListBox
                    x:Name="EverythingResultsList"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Margin="0,0,0,6"
                                Padding="10"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="5">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTip="{Binding}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                                        <Button
                                            Width="105"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Click="AddEverythingResult_Click"
                                            Content="Bağlama Ekle"
                                            Tag="{Binding}" />

                                        <Button
                                            Width="60"
                                            Height="28"
                                            Click="OpenEverythingResult_Click"
                                            Content="Aç"
                                            Tag="{Binding}" />

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

            <Button
                x:Name="LoadMoreEverythingButton"
                Grid.Row="3"
                Width="160"
                Height="34"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Click="LoadMoreEverything_Click"
                Content="Daha Fazla Göster"
                Visibility="Collapsed" />

        </Grid>

    </Grid>
</Window>