<Window x:Class="FileContext.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileContext"
        Height="700"
        Width="1100"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
           Text="FileContext"
           FontSize="28"
           FontWeight="SemiBold"
           Margin="0,0,0,16"/>


        <!-- ARAMA -->
        <DockPanel Grid.Row="1"
           Margin="0,0,0,16">

            <Button Content="+ Yeni Kayıt"
                    Width="120"
                    Height="36"
                    DockPanel.Dock="Right"
                    Margin="10,0,0,0"
                    Click="NewEntry_Click"/>

            <TextBox x:Name="SearchTextBox"
                     Height="36"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Bağlam veya fiziksel dosya ara..."/>

        </DockPanel>

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FILECONTEXT KAYITLARI -->
            <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock x:Name="ContextHeader"
                               Text="Bağlam Kayıtları"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <ItemsControl x:Name="EntriesList">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,12"
                                Padding="16">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="1"
                                           Text="{Binding Path}"
                                           Margin="0,8,0,16"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"/>

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="Bağlam / Açıklama"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>

                                                <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"/>

                                                <StackPanel Orientation="Horizontal"
                                                    Margin="0,18,0,0">

                                                    <Button Content="Aç"
                                                    Width="70"
                                                    Height="30"
                                                    Margin="0,0,8,0"
                                                    Tag="{Binding}"
                                                    Click="OpenEntry_Click"/>

                                                    <Button Content="Düzenle"
                                                    Width="80"
                                                    Height="30"
                                                    Margin="0,0,8,0"
                                                    Tag="{Binding}"
                                                    Click="EditEntry_Click"/>

                                                    <Button Content="Sil"
                                                    Width="60"
                                                    Height="30"
                                                    Tag="{Binding}"
                                                    Click="DeleteEntry_Click"/>

                                                </StackPanel>

                                            </StackPanel>

                                            <StackPanel Grid.Column="2">

                                                <TextBlock Text="Durum"
                                                   FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding Status}"
                                                   Margin="0,4,0,14"/>

                                                <TextBlock Text="Sonraki İşlem"
                                                   FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding NextAction}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,14"/>

                                                <TextBlock Text="Etiketler"
                                                   FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding Tags}"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                            </StackPanel>

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </ScrollViewer>

            <GridSplitter Grid.Row="1"
              Height="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              Background="#D0D0D0"
              Cursor="SizeNS"/>

            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- EVERYTHING BAŞLIK -->
            <TextBlock x:Name="EverythingHeader"
               Grid.Row="0"
               Text="Everything Sonuçları"
               FontSize="17"
               FontWeight="SemiBold"
               Margin="0,14,0,10"
               Visibility="Collapsed"/>

            <!-- VIRTUALIZED EVERYTHING RESULTS -->
            <ListBox x:Name="EverythingResultsList"
             Grid.Row="1"
             BorderThickness="0"
             Background="Transparent"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>
                        <Setter Property="Padding"
                        Value="0"/>
                        <Setter Property="Margin"
                        Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,6"
                        Padding="10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}"
                                               Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">

                                        <Button Content="Bağlama Ekle"
                                                Width="105"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Tag="{Binding}"
                                                Click="AddEverythingResult_Click"/>

                                        <Button Content="Aç"
                                                Width="60"
                                                Height="28"
                                                Tag="{Binding}"
                                                Click="OpenEverythingResult_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
            
            </Grid>
            
            <Button x:Name="LoadMoreEverythingButton"
            Grid.Row="3"
            Content="Daha Fazla Göster"
            Width="160"
            Height="34"
            HorizontalAlignment="Center"
            Margin="0,10,0,0"
            Visibility="Collapsed"
            Click="LoadMoreEverything_Click"/>

        </Grid>

    </Grid>
</Window>